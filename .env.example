# Copy to .env and fill in. Never commit .env.

# Neon Postgres: pooled connection (host contains "-pooler"), used by the app
DATABASE_URL=""
# Neon Postgres: direct connection (no "-pooler"), used by Prisma Migrate
DIRECT_URL=""

# Public site URL, no trailing slash. Placeholder until the Jibun domain is chosen.
# Read at BUILD time (it goes into QR codes and vCards): set it before building, rebuild if it changes.
NEXT_PUBLIC_SITE_URL="https://tapcard.ph"

# Template preview at /preview is on in development and off in production; set to 1 to allow it in production
ENABLE_PREVIEW=""

# Contact details: shown on /inactive and on the homepage. Read at BUILD time.
# Until they are set the homepage shows dummy values (hello@jibun.example, m.me/jibun.ph, ...): set all of them before launch.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_MESSENGER=
NEXT_PUBLIC_CONTACT_INSTAGRAM=
NEXT_PUBLIC_CONTACT_PHONE=
# Text for the "How do I pay?" answer, e.g. "GCash or Maya"
NEXT_PUBLIC_CONTACT_PAYMENT_METHODS=
# Footer links on the homepage. Optional: they default to the built-in /privacy and /terms pages
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=""

# Admin session signing key: a random string of 32+ characters (openssl rand -base64 48)
AUTH_SECRET=""

# Cloudinary (image upload; not read by the code yet, needed in the last step of the plan)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Copy to .env and fill in. Never commit .env.

# Neon Postgres: pooled connection (host contains "-pooler"), used by the app
DATABASE_URL=""
# Neon Postgres: direct connection (no "-pooler"), used by Prisma Migrate
DIRECT_URL=""

# Public site URL. Placeholder until the Jibun domain is chosen.
NEXT_PUBLIC_SITE_URL="https://tapcard.ph"

# Shown on the /inactive page (optional)
NEXT_PUBLIC_CONTACT_EMAIL=""

# Auth.js (Phase 3)
AUTH_SECRET=""

# Cloudinary (Phase 3, image upload)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
